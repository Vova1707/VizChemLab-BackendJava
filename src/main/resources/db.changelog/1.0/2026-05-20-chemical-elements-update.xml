    <!-- Добавляем недостающие колонки в таблицу periodic_table -->
    <changeSet id="2026-05-20-add-periodic-table-columns" author="kondrahin">
        <addColumn tableName="periodic_table">
            <column name="name_ru" type="varchar(100)"/>
        </addColumn>
        <addColumn tableName="periodic_table">
            <column name="atomic_number" type="integer"/>
        </addColumn>
        <addColumn tableName="periodic_table">
            <column name="atomic_mass" type="decimal(10,4)"/>
        </addColumn>
        <addColumn tableName="periodic_table">
            <column name="radius_angstrom" type="decimal(6,3)"/>
        </addColumn>
        <addColumn tableName="periodic_table">
            <column name="category" type="varchar(50)"/>
        </addColumn>
    </changeSet>

